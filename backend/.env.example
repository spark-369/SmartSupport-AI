# =============================================================================
# SmartSupport AI — backend environment (DEV)
# Copy to `.env` and adjust per environment. Never commit real secrets.
# =============================================================================

SMARTSUPPORT_ENVIRONMENT=dev
SMARTSUPPORT_DEBUG=true
SMARTSUPPORT_LOG_LEVEL=INFO

# --- Database (PostgreSQL; the container is already running) ---
SMARTSUPPORT_DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/smartsupport
SMARTSUPPORT_SYNC_DATABASE_URL=postgresql+psycopg2://postgres:mysecretpassword@localhost:5432/smartsupport

# --- Redis (cache / rate-limit db 0, celery broker db 1, results db 2) ---
SMARTSUPPORT_REDIS_URL=redis://localhost:6379/0
SMARTSUPPORT_CELERY_BROKER_URL=redis://localhost:6379/1
SMARTSUPPORT_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ---
# Generate a strong secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_hex(32))"
SMARTSUPPORT_JWT_SECRET=dev_9f2c7a1e5b8d4f6a0c3e7b1d9a8f5c2e
SMARTSUPPORT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SMARTSUPPORT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Ollama ---
SMARTSUPPORT_OLLAMA_BASE_URL=http://localhost:11434
SMARTSUPPORT_EMBEDDING_MODEL=hf.co/Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
SMARTSUPPORT_LLM_MODEL=hf.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF:Q4_K_M

# --- CORS ---
SMARTSUPPORT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Storage / ingestion ---
SMARTSUPPORT_UPLOAD_DIR=data/uploads

# --- Seed admin (used by scripts/seed.py) ---
SMARTSUPPORT_SEED_ADMIN_EMAIL=admin@smartsupport.io
SMARTSUPPORT_SEED_ADMIN_PASSWORD=Admin12345!
